# ==============================================================================
# SoundSphere Production Environment Variables Configuration Template
# Copy this file to .env.production on your hosting server and populate secrets
# ==============================================================================

# Node runtime environment (must be 'production' for live deployments)
NODE_ENV=production

# Application listen port (Default: 5001 or assigned by cloud platform like Heroku/Render)
PORT=5001

# Cryptographic JSON Web Token (JWT) secret key
# CRITICAL: Generate a strong 64-character random string using `openssl rand -hex 32`
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production

# JWT Expiration lifetime (e.g., 7d for 7 days, 24h for 24 hours)
JWT_EXPIRES_IN=7d

# Relational SQLite database path
# Ensure this directory is mounted on a persistent disk or volume across container restarts
DB_PATH=/var/data/soundsphere.db

# Allowed CORS origins (comma-separated list for production domains, or '*' for public API)
# Example: https://soundsphere.app,https://www.soundsphere.app
CORS_ORIGIN=https://soundsphere.app,https://www.soundsphere.app

# Optional front-end API URL override (for decoupled deployments on Vercel/Netlify)
# VITE_API_URL=https://api.soundsphere.app/api/v1
